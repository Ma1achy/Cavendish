// The window's layouts, as data (docs/slices/S18.md §2; docs/research/editor-ux.md §3.2): a
// layout is a name and the console lines that arrange the figure for a task. Choosing
// one runs its lines (each a view command: journalled, never an edit, never the selection; the
// check refuses anything else). The big scopes and their
// Tab order are the same in every layout; a layout changes where things are, never the order.
//
//   id     what `layout <id>` names
//   label  what the top bar's tab says
//   lines  the console lines it runs, in order; the figure's arrangement is a `panes` line or a
//          `mosaic` line (docs/design/workspace.md §1: a grid of labels as subplot_mosaic
//          writes it, a repeated label spanning cells; viewport N is the Nth label)
//   unfold the inspector's folding sections it opens (optional)
//   about  one line for the tooltip and the palette
// Its key is the action `layout <id>` of ui/actions.ron (Ctrl+1, 2, 3: not bare digits, which
// select towers).
(
    layouts: [
        (
            id: "scene",
            label: "Scene",
            lines: ["panes 1", "show scene @1", "pane 1"],
            about: "building and placing: one big view of the scene",
        ),
        (
            id: "instrument",
            label: "Instrument",
            lines: ["panes 2", "show scene @1", "show flight @2", "pane 2"],
            unfold: ["inspector/cadence", "inspector/instrument"],
            about: "the array and its timing: the scene beside the atoms' flights; with nothing selected, the instrument and cadence open in the inspector",
        ),
        (
            id: "analysis",
            label: "Analysis",
            // The signal wide along the top, the periodogram and the cadence's window under it,
            // the scene tall beside them.
            lines: ["mosaic \"AAC;BDC\"", "show signal @1", "show periodogram @2", "show scene @3", "show cadence @4", "pane 1"],
            about: "reading results: the signal over the periodogram and the cadence's window, with the scene beside them",
        ),
    ],
)
