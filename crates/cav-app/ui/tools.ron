// The tool strip, as data (docs/slices/S18.md §2). Each tool is a behaviour the code knows
// (Select, Translate, Place, Probe); its key is the action `tool <id>` in ui/actions.ron, so the keys,
// the ? sheet and the palette have it from one place. Probe came in S19; Scale, Paint, Measure and
// Slice come in S20 and Rotate after it (E and R are kept for Rotate and Scale).
//
//   snap_step  the Move tool's snap and the transform session's step, metres
//   tools      in the strip's order, top to bottom:
//              id, label (the tool's one name: strip tooltip, options row, menus, ? sheet),
//              behaviour (which also picks the button's icon), about
// Snap is not a tool: it is a toggle drawn apart, below the tools (the action `snap`).
(
    snap_step: 0.25,
    tools: [
        (
            id: "select",
            label: "Select",
            behaviour: Select,
            about: "click a body or a tower to select it; drag a body to move it in the view's plane",
        ),
        (
            id: "move",
            label: "Move",
            behaviour: Translate,
            about: "a gizmo on the selected body: drag an arrow to move it along x, y or z, snapped; drag the square to move it freely",
        ),
        (
            id: "place",
            label: "Place",
            behaviour: Place,
            about: "click the ground to add the chosen starter there",
        ),
        (
            id: "probe",
            label: "Probe",
            behaviour: Probe,
            about: "click a point: the bodies' gravity there, the voxel cell and its share of each tower's phase",
        ),
    ],
)
