// The first-person camera's settings (plan/REBUILD.md principle 11; docs/slices/S20.md §2).
// Window state, never part of a scene. `camera-set <setting> <value>` in the console changes
// one for the session; the names there are these with `-` for `_`.
(
    // How far a look turns per count of raw mouse motion, degrees per count.
    sensitivity: 0.1,
    // The flying speed at first, metres per second (the wheel changes it while flying, 0.05 to 1000).
    fly_speed: 4.0,
    // What sprinting (a double tap of W, or natively Ctrl held) multiplies the speed by.
    sprint: 2.0,
    // The time constant with which the velocity eases toward the wanted one, seconds.
    easing: 0.08,
    // Two presses of a key within this long are a double tap, seconds.
    double_tap: 0.3,
    // How long the speed is shown in the canvas after the wheel changed it, seconds.
    speed_shown: 1.5,
    // The physical camera (the walker): a player-sized box. Metres, metres per second.
    walk: (
        // The box: its side along x and y, its height, and the eye's height above its feet.
        width: 0.6,
        height: 1.8,
        eye_height: 1.62,
        // The walking speed (the wheel changes it while walking, 0.1 to 100), and what sprinting
        // and sneaking multiply it by.
        speed: 4.3,
        sprint: 1.3,
        sneak: 0.3,
        // How high a jump lifts the feet.
        jump_height: 1.25,
        // The highest step climbed (a step is one voxel of what is stood on or walked into).
        step_cap: 0.6,
    ),
)
