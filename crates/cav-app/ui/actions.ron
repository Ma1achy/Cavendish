// What the window offers, as data (plan/REBUILD.md principle 11; docs/slices/S18.md §2).
//
// `scopes`: the big scopes of the keyboard model (docs/design/keyboard.md), in Tab order. The
// order never depends on what is open or shown.
// `menus`: the menu bar's menus, left to right.
// `actions`: every action. Each is a console line (`line`), so the menus, the right-click menus,
// the palette, the tool palette and the keys are one path into the engine. Fields:
//   id      unique, the name keys and tests use
//   label   what a menu or the palette says
//   menu    where it sits in the menu bar: "View/Look from" is the "Look from" submenu of View;
//           empty for an action that is in no menu (keys and the palette only)
//   line    the console line it runs; {selection} is the selection's path (bodies[0],
//           array.towers[2]), {body} and {tower} its number from 1
//   scope   where its keys work: a big scope's id or a node's, or "global"
//   keys    its key chords: "Ctrl+Z", "Shift+F", "?", "Delete"
//   needs   when it can run: Always, Undo, Redo, Selection, Item (a body or a tower), Body,
//           Tower(n), Shapes, World (the scene has a world), Viewports (the figure has more than
//           one), AfterStart and BeforeEnd (where the playhead is), ShotBefore and ShotAfter (a
//           shot is read out before or after the playhead)
//   rule    a rule above it in its menu
//   context on the right-click menu of a row of the scene tree and of the view
//   about   one line for the palette and the ? sheet
//
// The Add menu is not listed here: it is the starters (scenes/starters.ron), each run as
// `add <name> at {place}`, {place} being where the camera looks, on the ground.
(
    scopes: [
        (id: "top-bar", name: "Top bar"),
        (id: "toolbar", name: "Tool palette"),
        (id: "tree", name: "Scene tree"),
        (id: "viewport", name: "Viewport"),
        (id: "inspector", name: "Inspector"),
        (id: "timeline", name: "Timeline"),
        (id: "footer", name: "Footer"),
    ],
    menus: ["File", "Edit", "Add", "View", "Scene", "Array", "Help"],
    actions: [
        // File
        (id: "new", label: "New scene…", menu: "File", line: "wizard", keys: ["Ctrl+N"], about: "start a scene: the array, the surroundings, a first body, the duration"),
        (id: "open", label: "Open…", menu: "File", line: "open", keys: ["Ctrl+O"], about: "open a library scene or a file"),
        (id: "save", label: "Save", menu: "File", line: "save-scene", keys: ["Ctrl+S"], about: "save the scene to its file, or ask for one (in the page: a download)"),
        (id: "save-as", label: "Save as…", menu: "File", line: "save-as", keys: ["Ctrl+Shift+S"], about: "save the scene to a file named in a box"),
        (id: "import-mesh", label: "Import mesh…", menu: "File", line: "import-mesh", about: "add a body made from an OBJ or STL file: dropped on the window, or a path; its size, material and pitch"),
        (id: "new-room", label: "room", menu: "File/New from template", line: "load room", about: "the default room with the five-tower array"),
        (id: "new-void", label: "void", menu: "File/New from template", line: "load void", about: "the array and nothing else"),
        (id: "new-floor", label: "infinite floor", menu: "File/New from template", line: "load infinite-floor", about: "a floor to the horizon below the array"),
        (id: "new-point", label: "a mass beside the array", menu: "File/New from template", line: "load point", about: "one point mass near tower 1"),
        (id: "new-pass", label: "a mass passing the array", menu: "File/New from template", line: "load pass", about: "a mass going past the towers"),
        (id: "new-comb", label: "an oscillator", menu: "File/New from template", line: "load comb", about: "an oscillating mass and its comb of harmonics"),
        (id: "new-sphere", label: "a voxel sphere", menu: "File/New from template", line: "load sphere", about: "a voxel body, coloured by level"),
        (id: "new-world-box", label: "a world with a box", menu: "File/New from template", line: "load world-box", about: "a world volume holding one box"),
        (id: "new-town", label: "a town", menu: "File/New from template", line: "load town", about: "terrain, buildings and a road around the array"),
        (id: "quit", label: "Quit", menu: "File", line: "quit", rule: true, about: "close the application"),

        // Edit
        (id: "undo", label: "Undo", menu: "Edit", line: "undo", keys: ["Ctrl+Z"], needs: Undo, about: "take back the last edit, whatever made it"),
        (id: "redo", label: "Redo", menu: "Edit", line: "redo", keys: ["Ctrl+Shift+Z", "Ctrl+Y"], needs: Redo, about: "put back the edit last taken back"),
        (id: "history", label: "History…", menu: "Edit", line: "history", keys: ["Ctrl+H"], about: "every edit, with the line that made it; click one to go back or forward to it"),
        (id: "duplicate", label: "Duplicate", menu: "Edit", line: "duplicate {selection}", scope: "tree", keys: ["Ctrl+D"], needs: Item, rule: true, context: true, about: "a copy of the selected body or tower beside it"),
        (id: "duplicate-in-view", label: "Duplicate", line: "duplicate {selection}", scope: "viewport", keys: ["Ctrl+D"], needs: Item, about: "a copy of the selected body or tower beside it"),
        (id: "rename", label: "Rename", menu: "Edit", line: "rename", scope: "tree", keys: ["F2"], needs: Named, context: true, about: "type a new name for the selected body or tower, or the folder in focus"),
        (id: "new-folder", label: "New folder", menu: "Edit", line: "new-folder", context: true, about: "a folder in the scene tree, beside the selection or inside the folder in focus; then type its name"),
        (id: "delete", label: "Delete", menu: "Edit", line: "remove {selection}", scope: "tree", keys: ["Delete"], needs: Item, context: true, about: "take the selected body or tower out of the scene"),
        (id: "delete-in-view", label: "Delete", line: "remove {selection}", scope: "viewport", keys: ["Delete"], needs: Item, about: "take the selected body or tower out of the scene"),
        (id: "tool-select", label: "Select", menu: "Edit/Tool", line: "tool select", scope: "toolbar", keys: ["Q"], rule: true, about: "the Select tool: click selects, a drag moves a body in the view's plane"),
        (id: "tool-move", label: "Move", menu: "Edit/Tool", line: "tool move", scope: "toolbar", keys: ["W"], about: "the Move tool: a gizmo on the selected body, snapped"),
        (id: "tool-place", label: "Place", menu: "Edit/Tool", line: "tool place", scope: "toolbar", keys: ["A"], about: "the Place tool: click the ground to add the chosen starter there (hold or right-click its button to choose it)"),
        (id: "tool-probe", label: "Probe", menu: "Edit/Tool", line: "tool probe", scope: "toolbar", keys: ["I"], about: "the Probe tool: click a point to read the gravity there and the cell's share of each tower's phase"),
        (id: "snap", label: "Snap to the step", menu: "Edit", line: "snap", scope: "toolbar", keys: ["S"], about: "snap moves to the step (0.25 m), or not: a toggle, not a tool"),
        (id: "tool-select-in-view", label: "Select", line: "tool select", scope: "viewport", keys: ["Q"], about: "the Select tool"),
        (id: "tool-move-in-view", label: "Move", line: "tool move", scope: "viewport", keys: ["W"], about: "the Move tool"),
        (id: "tool-place-in-view", label: "Place", line: "tool place", scope: "viewport", keys: ["A"], about: "the Place tool"),
        (id: "tool-probe-in-view", label: "Probe", line: "tool probe", scope: "viewport", keys: ["I"], about: "the Probe tool"),
        (id: "snap-in-view", label: "Snap to the step", line: "snap", scope: "viewport", keys: ["S"], about: "snap moves to the step, or not"),
        (id: "reset-field", label: "Reset the field", line: "reset {field}", scope: "inspector", keys: ["Backspace"], about: "put the focused field back as the scene was opened or saved"),
        (id: "add-here", label: "Add…", line: "palette add", scope: "tree", keys: ["A"], about: "search the things to add: bodies, shapes, a tower"),
        (id: "select-none", label: "Select nothing", menu: "Edit", line: "select none", needs: Selection, rule: true, about: "clear the selection (Esc in the viewport does too)"),

        // View
        (id: "palette", label: "Command palette…", menu: "View", line: "palette", keys: ["Ctrl+K", "Ctrl+Shift+P"], about: "search every action, starter, scene and field"),
        (id: "look-iso", label: "iso", menu: "View/Look from", line: "view iso", about: "look from the south-west, above"),
        (id: "look-top", label: "top", menu: "View/Look from", line: "view top", about: "plan view, from above"),
        (id: "look-bottom", label: "bottom", menu: "View/Look from", line: "view bottom", about: "from below"),
        (id: "look-north", label: "north", menu: "View/Look from", line: "view north", about: "from the north, looking south"),
        (id: "look-south", label: "south", menu: "View/Look from", line: "view south", about: "from the south, looking north"),
        (id: "look-east", label: "east", menu: "View/Look from", line: "view east", about: "from the east, looking west"),
        (id: "look-west", label: "west", menu: "View/Look from", line: "view west", about: "from the west, looking east"),
        (id: "view-home", label: "Home", menu: "View", line: "view home", keys: ["Home"], about: "reset the active pane's camera (undo takes it back)"),
        (id: "frame", label: "Frame the selection", menu: "View", line: "frame", scope: "viewport", keys: ["F"], about: "fit the selection, or the whole scene, into the active pane"),
        (id: "frame-in-tree", label: "Frame the selection", line: "frame", scope: "tree", keys: ["F"], context: true, about: "fit the selection into the active pane"),
        (id: "fly", label: "Fly", menu: "View", line: "fly", scope: "viewport", keys: ["Shift+F"], about: "fly the camera: W A S D, E up, Q down, arrows or a drag to look; Enter or Esc to stop"),
        (id: "proj-persp", label: "perspective", menu: "View/Projection", line: "proj persp", about: "a perspective camera"),
        (id: "proj-ortho", label: "orthographic", menu: "View/Projection", line: "proj ortho", about: "an orthographic camera"),
        (id: "proj-toggle", label: "toggle", menu: "View/Projection", line: "proj toggle", scope: "viewport", keys: ["O"], about: "swap perspective and orthographic"),
        (id: "panes-1", label: "1", menu: "View/Panes", line: "panes 1", about: "one pane"),
        (id: "panes-2", label: "2", menu: "View/Panes", line: "panes 2", about: "two panes side by side"),
        (id: "panes-4", label: "4", menu: "View/Panes", line: "panes 4", about: "four panes"),
        (id: "show-scene", label: "the scene", menu: "View/Show in the pane", line: "show scene", about: "the active pane shows the scene"),
        (id: "show-signal", label: "the signal", menu: "View/Show in the pane", line: "show signal", about: "every tower's signal against time"),
        (id: "show-periodogram", label: "the periodogram", menu: "View/Show in the pane", line: "show periodogram", about: "the periodogram with each body's comb"),
        (id: "show-flight", label: "the flights", menu: "View/Show in the pane", line: "show flight", about: "the atoms' flights on absolute time"),
        (id: "show-cadence", label: "the cadence", menu: "View/Show in the pane", line: "show cadence", about: "the cadence's spectral window"),
        (id: "span-all", label: "Show all", menu: "View", line: "span all", about: "the whole of the active plot's horizontal axis (a double click on the plot does too)"),
        (id: "style-shaded", label: "shaded", menu: "View/Draw style", line: "style shaded", about: "shaded surfaces"),
        (id: "style-flat", label: "flat", menu: "View/Draw style", line: "style flat", about: "flat colours"),
        (id: "style-xray", label: "x-ray", menu: "View/Draw style", line: "style xray", about: "additive, see-through"),
        (id: "style-wireframe", label: "wireframe", menu: "View/Draw style", line: "style wireframe", about: "edges only"),
        (id: "style-paper", label: "paper", menu: "View/Draw style", line: "style paper", about: "ink on cream paper"),
        (id: "colour-level", label: "tree level", menu: "View/Colour voxels by", line: "colour level", needs: Shapes, about: "colour each leaf by its level in the tree"),
        (id: "colour-depth", label: "depth", menu: "View/Colour voxels by", line: "colour depth", needs: Shapes, about: "colour each leaf by its depth"),
        (id: "colour-mass", label: "mass", menu: "View/Colour voxels by", line: "colour mass", needs: Shapes, about: "colour each leaf by its mass"),
        (id: "colour-fill", label: "fill", menu: "View/Colour voxels by", line: "colour fill", needs: Shapes, about: "colour each leaf by how full it is"),
        (id: "colour-material", label: "material", menu: "View/Colour voxels by", line: "colour material", needs: Shapes, about: "colour each leaf by its material"),
        (id: "overlay-none", label: "none", menu: "View/Overlay", line: "overlay none", about: "no overlay"),
        (id: "overlay-leaves", label: "leaf bounds", menu: "View/Overlay", line: "overlay leaves", needs: Shapes, about: "each leaf's bounds, by level"),
        (id: "overlay-tree", label: "the whole octree", menu: "View/Overlay", line: "overlay tree", needs: Shapes, about: "every node of every voxel body's tree, by depth"),
        (id: "overlay-tree-deep", label: "octree, deep solid", menu: "View/Overlay", line: "overlay tree fade deep", needs: Shapes, about: "the whole octree, its deep nodes solid and its shallow ones faint"),
        (id: "overlay-bands", label: "LOD bands", menu: "View/Overlay", line: "overlay bands", needs: World, about: "the world drawn in the colours of its levels of detail"),
        (id: "section-off", label: "no section", menu: "View/Overlay", line: "section off", needs: Shapes, rule: true, about: "take the section plane away"),
        (id: "tool-palette-top-left", label: "top left", menu: "View/Tool palette", line: "tool-palette top-left", about: "stand the tool palette at the top left corner of the view (where it starts); kept for this layout (its grip drags it there too)"),
        (id: "tool-palette-top", label: "top", menu: "View/Tool palette", line: "tool-palette top", about: "stand the tool palette at along the middle of the view's top edge; kept for this layout (its grip drags it there too)"),
        (id: "tool-palette-top-right", label: "top right", menu: "View/Tool palette", line: "tool-palette top-right", about: "stand the tool palette at the top right corner of the view, under the navigation gizmo; kept for this layout (its grip drags it there too)"),
        (id: "tool-palette-left", label: "left", menu: "View/Tool palette", line: "tool-palette left", about: "stand the tool palette at the middle of the view's left edge; kept for this layout (its grip drags it there too)"),
        (id: "tool-palette-right", label: "right", menu: "View/Tool palette", line: "tool-palette right", about: "stand the tool palette at the middle of the view's right edge; kept for this layout (its grip drags it there too)"),
        (id: "tool-palette-bottom-left", label: "bottom left", menu: "View/Tool palette", line: "tool-palette bottom-left", about: "stand the tool palette at the bottom left corner of the view; kept for this layout (its grip drags it there too)"),
        (id: "tool-palette-bottom", label: "bottom", menu: "View/Tool palette", line: "tool-palette bottom", about: "stand the tool palette at along the middle of the view's bottom edge; kept for this layout (its grip drags it there too)"),
        (id: "tool-palette-bottom-right", label: "bottom right", menu: "View/Tool palette", line: "tool-palette bottom-right", about: "stand the tool palette at the bottom right corner of the view; kept for this layout (its grip drags it there too)"),
        (id: "layout-scene", label: "Scene", menu: "View/Layout", line: "layout scene", keys: ["Ctrl+1"], about: "building and placing: one big view of the scene"),
        (id: "layout-instrument", label: "Instrument", menu: "View/Layout", line: "layout instrument", keys: ["Ctrl+2"], about: "the array and its timing: the scene beside the flights"),
        (id: "layout-analysis", label: "Analysis", menu: "View/Layout", line: "layout analysis", keys: ["Ctrl+3"], about: "reading results: signal, periodogram, cadence and the scene"),
        (id: "layout-save", label: "Save as a new layout", menu: "View/Layout", line: "layout save", rule: true, about: "keep the figure's present arrangement (the mosaic and what each viewport shows) as a new layout, a tab of the top bar, for this session; `layout save <name>` names it"),
        // The Viewport submenu is also every viewport's right-click menu (panels.rs, VIEWPORT_MENU).
        (id: "split-right", label: "Split right", menu: "View/Viewport", line: "split right", about: "split the active viewport in two, side by side: the new one starts as a copy of it"),
        (id: "split-down", label: "Split down", menu: "View/Viewport", line: "split down", about: "split the active viewport in two, one above the other: the new one starts as a copy of it"),
        (id: "viewport-close", label: "Close", menu: "View/Viewport", line: "viewport close", needs: Viewports, about: "close the active viewport: a neighbour grows into its place"),
        (id: "viewport-swap", label: "Swap with the next", menu: "View/Viewport", line: "viewport swap", needs: Viewports, rule: true, about: "exchange the active viewport's place with the next one's; each keeps its camera and what it shows"),
        (id: "mosaic-even", label: "Even the splitters", menu: "View/Viewport", line: "mosaic even", about: "every column as wide and every row as high as the others (a double click on a splitter evens its two sides)"),
        (id: "viewport-pop-out", label: "Pop out / dock", menu: "View/Viewport", line: "viewport pop-out", rule: true, about: "float the active viewport over the window, or put it back in its place in the mosaic"),
        (id: "maximise", label: "Maximise", menu: "View/Viewport", line: "maximise", keys: ["Ctrl+Space"], about: "the active viewport fills the window but for the menu bar and the status line; again to restore"),
        (id: "fullscreen", label: "Full screen", menu: "View", line: "fullscreen", keys: ["F11"], rule: true, about: "the window fills the screen; again to restore"),
        (id: "gui", label: "Hide the GUI", menu: "View", line: "gui", keys: ["F3"], about: "the scene fills the window; F3 or Esc brings the panels back"),
        (id: "console", label: "Console", menu: "View", line: "console", keys: ["`"], about: "open or close the console: every command, typed"),

        // Scene
        (id: "play", label: "Play / pause", menu: "Scene", line: "play", keys: ["Space"], about: "start or stop the playhead"),
        // The transport's buttons (transport.rs, CONTROLS) are these; their keys work in the timeline.
        (id: "seek-start", label: "To the start", menu: "Scene", line: "seek start", scope: "timeline", keys: ["Alt+["], needs: AfterStart, about: "the playhead to the start of the timeline"),
        (id: "step-back", label: "Step back", menu: "Scene", line: "step -1", scope: "timeline", keys: ["["], needs: ShotBefore, about: "the playhead to the shot read out before it (the selected tower's shots, else the first tower's); with Shift one cadence cycle back; hold to scrub"),
        (id: "step-forward", label: "Step forward", menu: "Scene", line: "step 1", scope: "timeline", keys: ["]"], needs: ShotAfter, about: "the playhead to the next shot's readout (the selected tower's shots, else the first tower's); with Shift one cadence cycle on; hold to scrub"),
        (id: "seek-end", label: "To the end", menu: "Scene", line: "seek end", scope: "timeline", keys: ["Alt+]"], needs: BeforeEnd, about: "the playhead to the end of the timeline"),
        (id: "step-back-cycle", label: "Back one cycle", menu: "Scene", line: "step -1 cycle", scope: "timeline", keys: ["Shift+[", "{"], needs: AfterStart, about: "the playhead back by one mean cadence cycle"),
        (id: "step-forward-cycle", label: "On one cycle", menu: "Scene", line: "step 1 cycle", scope: "timeline", keys: ["Shift+]", "}"], needs: BeforeEnd, about: "the playhead on by one mean cadence cycle"),
        (id: "end-loop", label: "Loop", menu: "Scene/At the end", line: "end loop", about: "at the end of the timeline the playhead goes back to the start and playing goes on"),
        (id: "end-stop", label: "Stop at the end", menu: "Scene/At the end", line: "end stop", about: "at the end of the timeline the playhead stops there, and playing stops"),
        (id: "end-run-on", label: "Run on", menu: "Scene/At the end", line: "end run-on", about: "at the end of the timeline the scene's duration grows by its length when playing began, and playing goes on: one edit a run (Ctrl+Z takes it back), up to the longest timeline a scene may have; the signal is computed again for each longer timeline"),
        (id: "speed-0.1", label: "0.1×", menu: "Scene/Speed", line: "speed 0.1", about: "play at a tenth of the clock's rate"),
        (id: "speed-0.25", label: "0.25×", menu: "Scene/Speed", line: "speed 0.25", about: "play at a quarter of the clock's rate"),
        (id: "speed-0.5", label: "0.5×", menu: "Scene/Speed", line: "speed 0.5", about: "play at half the clock's rate"),
        (id: "speed-1", label: "1×", menu: "Scene/Speed", line: "speed 1", about: "play at the clock's rate: a second of the scene a second"),
        (id: "speed-2", label: "2×", menu: "Scene/Speed", line: "speed 2", about: "play at twice the clock's rate"),
        (id: "speed-5", label: "5×", menu: "Scene/Speed", line: "speed 5", about: "play at five times the clock's rate"),
        (id: "speed-10", label: "10×", menu: "Scene/Speed", line: "speed 10", about: "play at ten times the clock's rate"),
        (id: "run", label: "Compute again", menu: "Scene", line: "run", rule: true, about: "compute the signal again from nothing"),

        // Array
        (id: "select-tower-1", label: "tower 1", menu: "Array/Select tower", line: "select tower 1", scope: "viewport", keys: ["1"], needs: Tower(1), about: "select tower 1"),
        (id: "select-tower-2", label: "tower 2", menu: "Array/Select tower", line: "select tower 2", scope: "viewport", keys: ["2"], needs: Tower(2), about: "select tower 2"),
        (id: "select-tower-3", label: "tower 3", menu: "Array/Select tower", line: "select tower 3", scope: "viewport", keys: ["3"], needs: Tower(3), about: "select tower 3"),
        (id: "select-tower-4", label: "tower 4", menu: "Array/Select tower", line: "select tower 4", scope: "viewport", keys: ["4"], needs: Tower(4), about: "select tower 4"),
        (id: "select-tower-5", label: "tower 5", menu: "Array/Select tower", line: "select tower 5", scope: "viewport", keys: ["5"], needs: Tower(5), about: "select tower 5"),
        (id: "select-tower-6", label: "tower 6", menu: "", line: "select tower 6", scope: "viewport", keys: ["6"], needs: Tower(6), about: "select tower 6"),
        (id: "select-tower-7", label: "tower 7", menu: "", line: "select tower 7", scope: "viewport", keys: ["7"], needs: Tower(7), about: "select tower 7"),
        (id: "select-tower-8", label: "tower 8", menu: "", line: "select tower 8", scope: "viewport", keys: ["8"], needs: Tower(8), about: "select tower 8"),
        (id: "select-tower-9", label: "tower 9", menu: "", line: "select tower 9", scope: "viewport", keys: ["9"], needs: Tower(9), about: "select tower 9"),
        (id: "tree-tower-1", label: "tower 1", line: "select tower 1", scope: "tree", keys: ["1"], needs: Tower(1), about: "select tower 1"),
        (id: "tree-tower-2", label: "tower 2", line: "select tower 2", scope: "tree", keys: ["2"], needs: Tower(2), about: "select tower 2"),
        (id: "tree-tower-3", label: "tower 3", line: "select tower 3", scope: "tree", keys: ["3"], needs: Tower(3), about: "select tower 3"),
        (id: "tree-tower-4", label: "tower 4", line: "select tower 4", scope: "tree", keys: ["4"], needs: Tower(4), about: "select tower 4"),
        (id: "tree-tower-5", label: "tower 5", line: "select tower 5", scope: "tree", keys: ["5"], needs: Tower(5), about: "select tower 5"),
        (id: "preset-aion10", label: "AION-10", menu: "Array/Instrument", line: "preset aion10", about: "the instrument to the AION-10 preset"),
        (id: "preset-aice", label: "AICE 140 m", menu: "Array/Instrument", line: "preset aice", about: "the instrument to the AICE preset"),
        (id: "compare-aion10", label: "AION-10", menu: "Array/Compare with", line: "compare aion10", about: "read the scene on AION-10 as well"),
        (id: "compare-aice", label: "AICE", menu: "Array/Compare with", line: "compare aice", about: "read the scene on AICE as well"),
        (id: "compare-off", label: "nothing", menu: "Array/Compare with", line: "compare off", about: "stop comparing"),

        // Help
        (id: "keys", label: "Keyboard reference", menu: "Help", line: "keys", keys: ["?"], about: "every key, by where it works"),
        (id: "help", label: "Console commands", menu: "Help", line: "help", about: "every console command"),
        (id: "schema", label: "Scene spec reference", menu: "Help", line: "schema", about: "the scene spec's JSON Schema"),
        (id: "about", label: "About Cavendish", menu: "Help", line: "about", about: "version and credits"),
    ],
)
